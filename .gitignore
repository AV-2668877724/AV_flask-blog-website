# ===================================
# USER UPLOADS (PRIVACY)
# ===================================
# Ignore everything inside the uploads folders
website/static/uploads/avatars/*
website/static/uploads/posts/*
website/static/uploads/*

# BUT... Keep the folders themselves so the app doesn't crash
!website/static/uploads/.gitkeep
!website/static/uploads/avatars/.gitkeep
!website/static/uploads/posts/.gitkeep

